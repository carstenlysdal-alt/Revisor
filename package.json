{
  "name": "revisor-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "build": "npm run typecheck && vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/server.js",
    "start": "NODE_ENV=production node dist/server/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@google/genai": "2.22.0",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "lucide-react": "0.546.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "4.17.25",
    "@types/node": "22.20.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.25.12",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
