# ---------------------------------------------------------------- AI-udbyder
# Bilagslæsning og revisor-chat. Uden en nøgle er begge dele slået fra, og
# appen siger det tydeligt i stedet for at gætte på et resultat.
#
# Gemini er standardvalget: den tager PDF direkte, også scannede sider, og
# læser fotograferede kvitteringer bedst. Det er den, appens kernefunktion
# står og falder med.
GEMINI_API_KEY=""

# DeepSeek som alternativ. Billigere, men den tager ikke PDF (teksten trækkes
# så ud på serveren først) og billeder tokeniseres til højst 384 tokens, hvilket
# er groft til en tætskrevet kontrakt på et foto.
DEEPSEEK_API_KEY=""

# Er begge nøgler sat, vælges Gemini. Sæt "gemini" eller "deepseek" for at
# tvinge valget.
AI_UDBYDER=""

# Modelnavne. Lad dem stå tomme for at bruge standarderne.
GEMINI_MODEL=""
DEEPSEEK_MODEL=""
DEEPSEEK_VISION_MODEL=""

# ----------------------------------------------------------------- Websøgning
# Revisor-chatten slår regler og satser op på skat.dk og retsinformation.dk i
# stedet for at svare efter hukommelsen. Uden nøgle bruges DuckDuckGo.
TAVILY_API_KEY=""

# --------------------------------------------------------------------- Lager
# Hvor data og bilag gemmes. Uden DATABASE_URL bruges en JSON-fil og en
# bilagsmappe under denne sti.
DATA_DIR="./data"

# Postgres på Railway. Når den er sat, træder Postgres-driveren i stedet for
# fil-lageret. Lad den stå tom, indtil databasen findes.
DATABASE_URL=""

PORT="3000"
