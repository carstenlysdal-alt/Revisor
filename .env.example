# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# Optional stable Gemini model ID. Defaults to gemini-3.8-flash.
GEMINI_MODEL="gemini-3.8-flash"

# Maximum AI requests accepted from one IP in a 15-minute window.
AI_RATE_LIMIT="30"

# Port used by the Express server.
PORT="3000"

# Valgfri adgangsbeskyttelse til en privat installation.
# Sæt begge værdier; browseren viser derefter en login-dialog.
APP_USERNAME=
APP_PASSWORD=
